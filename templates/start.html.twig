{% extends "base.html.twig" %}
{% set section = "build" %}

{% block title %}Start: build a todo app on Waaseyaa{% endblock %}
{% block description %}Build a complete local todo application on {{ framework_version }}: install, define an entity, register routes, render a template, and verify the result.{% endblock %}



{% block head %}
<link rel="canonical" href="{{ canonical_base }}/start">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Start: build a todo app on Waaseyaa",
  "url": "{{ canonical_base }}/start",
  "about": "Getting started with the Waaseyaa PHP framework",
  "isPartOf": { "@type": "WebSite", "name": "Waaseyaa", "url": "{{ canonical_base }}/" }
}
