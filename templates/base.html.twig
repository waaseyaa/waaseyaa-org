<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Waaseyaa{% endblock %}</title>
  <meta name="description" content="{% block description %}An open-source PHP framework for structured content, publishing workflows, and AI-assisted tools. Build content applications on infrastructure you control. Waaseyaa is alpha software.{% endblock %}">
  <meta name="robots" content="{% block robots %}index,follow{% endblock %}">
  <meta name="theme-color" content="#0f766e">
  {# Open Graph / Twitter. Defaults derive from the title + description; pages may
     override og_title, og_description, og_image, or og_url. #}
  <meta property="og:type" content="{% block og_type %}website{% endblock %}">
  <meta property="og:site_name" content="Waaseyaa">
  <meta property="og:url" content="{% block og_url %}https://waaseyaa.org/{% endblock %}">
  <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
  <meta property="og:description" content="{% block og_description %}{{ block('description') }}{% endblock %}">
  <meta property="og:image" content="{% block og_image %}https://waaseyaa.org/images/og/og-default.png{% endblock %}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Waaseyaa: build content applications you control.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ block('og_title') }}">
  <meta name="twitter:description" content="{{ block('og_description') }}">
  <meta name="twitter:image" content="{{ block('og_image') }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=20398e0fb720">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/redesign.css?v=991002c6287f">
  {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">

<a class="skip" href="#main">Skip to content</a>

<header class="header wrap"><a class="wordmark" href="/" aria-label="Waaseyaa home">waase<span>yaa</span></a><nav aria-label="Main navigation">{% include 'navigation.html.twig' %}</nav><a class="github" href="https://github.com/waaseyaa/framework" target="_blank" rel="noreferrer" aria-label="Waaseyaa on GitHub" title="Waaseyaa on GitHub"><svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.77-.244.77-.542 0-.267-.01-.975-.016-1.914-3.13.68-3.79-1.508-3.79-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.699.078-.685.078-.685 1.13.08 1.725 1.16 1.725 1.16 1.005 1.722 2.637 1.224 3.279.936.102-.727.393-1.224.715-1.505-2.499-.284-5.126-1.25-5.126-5.563 0-1.229.44-2.232 1.16-3.019-.116-.285-.503-1.429.11-2.978 0 0 .945-.302 3.094 1.153A10.79 10.79 0 0 1 12 6.183c.956.004 1.919.129 2.817.38 2.148-1.455 3.092-1.153 3.092-1.153.615 1.549.228 2.693.112 2.978.722.787 1.159 1.79 1.159 3.019 0 4.325-2.631 5.276-5.138 5.555.404.35.764 1.042.764 2.1 0 1.518-.014 2.742-.014 3.114 0 .3.203.651.774.54A11.252 11.252 0 0 0 12 .75Z"/></svg></a></header>

{% block content %}{% endblock %}

<footer class="foot wrap">
  <span>this site is a waaseyaa application &middot; framework {{ framework_version|default('') }}</span>
  <span>agents: <a href="/llms.txt">/llms.txt</a> &middot; <a href="/.well-known/mcp.json">/.well-known/mcp.json</a> &middot; accept: text/markdown</span>
  <span><a href="https://github.com/waaseyaa/framework">github</a> &middot; <a href="https://packagist.org/packages/waaseyaa/framework">packagist</a></span>
</footer>

{% block scripts %}{% endblock %}
</body>
</html>
